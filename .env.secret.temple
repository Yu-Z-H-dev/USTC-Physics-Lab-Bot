BASE_URL=https://api.longcat.chat/openai/v1 #使用openai格式的API
API_KEY=""
MODEL_THINK=""
AI_TIMEOUT=180 # AI 请求总超时秒数（推理模型建议 ≥180），留空默认 180，两个 AI 插件共用
AI_CONCURRENCY=5 # AI 请求并发上限（默认 5），过高冲击API链路、过低排队拖慢
DAWU_ALLOWED_GROUPS= # 允许使用dawu插件的群聊（OneBot 数字群号），多个用逗号分隔，留空=全部放行
DAWU2_ALLOWED_GROUPS= # 同上，dawu2 独立配置

# —— QQ 官方机器人（群机器人，WebSocket 长连接）——
# intent 只要 c2c_group_at_messages（群聊/全量消息 + 私聊）与 group_members；
# 频道那套（guilds / at_messages…）个人群机器人没有权限，加了会 INVALID_SESSION。
# QQ_BOTS=[{"id":"<AppID>","secret":"<AppSecret>","intent":{"c2c_group_at_messages":true,"group_members":true},"use_websocket":true}]
# QQ_IS_SANDBOX=false

# 官方机器人的群白名单：group_openid（十六进制字符串，按机器人加密，需从日志收集），留空=全部放行
DAWU_QQ_ALLOWED_GROUPS=
DAWU2_QQ_ALLOWED_GROUPS=
